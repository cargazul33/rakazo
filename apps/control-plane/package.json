{
  "name": "@rakazo/control-plane",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "check": "tsc --noEmit",
    "db:create": "wrangler d1 create rakazo-agent-army",
    "db:migrate:local": "wrangler d1 migrations apply rakazo-agent-army --local",
    "db:migrate:remote": "wrangler d1 migrations apply rakazo-agent-army --remote",
    "r2:create": "wrangler r2 bucket create rakazo-agent-artifacts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260820.0",
    "typescript": "^5.9.2",
    "wrangler": "^4.30.0"
  }
}
