[Unit]
Description=Rakazo Edge Worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rakazo
WorkingDirectory=/srv/rakazo
EnvironmentFile=/etc/rakazo-edge-worker.env
ExecStart=/usr/bin/python3 /srv/rakazo/infra/edge-workers/worker.py
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/tmp

[Install]
WantedBy=multi-user.target
